# Backend configuration for Team Ticket Viewer

# Server
# Port is defaulted to 3001 by the app. You can override if needed.
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Jira credentials (required for tickets endpoints)
# Obtain values from your Atlassian account and Jira site.
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token
JIRA_BASE_URL=https://your-domain.atlassian.net

# Cache TTL in seconds (optional, default 300)
CACHE_TTL_SECONDS=300
