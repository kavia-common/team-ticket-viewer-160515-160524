# Backend configuration example for Jira integration

# Base URL of your Jira Cloud/Server instance (no trailing slash)
# e.g., https://your-domain.atlassian.net
JIRA_BASE_URL=https://your-domain.atlassian.net

# Authorization header value for Jira REST API.
# Typically Basic base64(email:api_token) for Jira Cloud.
# Example: Basic dXNlckBleGFtcGxlLmNvbTphcGlfdG9rZW5fMTIzNA==
JIRA_AUTH_HEADER=Basic <base64-email:api-token>

# Existing endpoints may also use these (optional for this new endpoint):
# JIRA_EMAIL=user@example.com
# JIRA_API_TOKEN=your_api_token_here

# Server port (optional)
# PORT=3001

# Cache TTL in seconds (optional)
# CACHE_TTL_SECONDS=300
